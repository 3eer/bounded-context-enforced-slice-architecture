{
  "name": "@besa/cli",
  "version": "0.1.0",
  "description": "Bounded-context Enforced Slice Architecture — DDD boundaries enforced by types and lint, not convention",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/lil-o-pg/bounded-context-enforced-slice-architecture",
  "repository": {
    "type": "git",
    "url": "httphttps://github.com/lil-o-pg/bounded-context-enforced-slice-architecture.git"
  },
  "keywords": [
    "ddd",
    "domain-driven-design",
    "bounded-context",
    "architecture",
    "cli",
    "typescript",
    "codegen",
    "eslint",
    "monorepo"
  ],
  "bin": {
    "besa": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest",
    "test:run": "vitest --run",
    "prepublishOnly": "pnpm build && pnpm test:run"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "js-yaml": "^4.1.0",
    "picocolors": "^1.1.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "eslint-formatter-compact": "^9.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "@typescript-eslint/eslint-plugin": ">=6",
    "eslint": ">=8",
    "eslint-plugin-boundaries": ">=4"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-plugin-boundaries": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
